    log_event("queue", "UNSKIPPED", reel_id, str(row["filename"]))
    return f"Reel #{reel_id} returned to its original queue position."


def retry_failed(reel_id: int) -> str:
    conn = connect()
    try:
        row = conn.execute("SELECT * FROM reels WHERE id=?", (reel_id,)).fetchone()
        if not row:
            return f"Reel #{reel_id} not found."
        if str(row["status"]) != "FAILED":
            return f"Reel #{reel_id} is {row['status']}, not FAILED."
        conn.execute(
            "UPDATE reels SET status='PENDING', attempts=0, last_error=NULL, updated_at=? WHERE id=?",
            (iso(), reel_id),
        )
        conn.commit()
    finally:
        conn.close()
    log_event("queue", "RETRY_RESET", reel_id, str(row["filename"]))
    return f"Reel #{reel_id} reset to PENDING with a fresh 3-attempt retry allowance."


# ----------------------------- Backups -----------------------------
def backup_status_text() -> str:
    last = parse_iso(get_meta("last_backup_at", ""))
    if last:
        due = last + dt.timedelta(hours=BACKUP_INTERVAL_HOURS)
        return f"BACKUP STATUS\nLast successful backup: {last.astimezone(TZ).strftime('%d %b %Y, %I:%M %p IST')}\nNext due: {due.astimezone(TZ).strftime('%d %b %Y, %I:%M %p IST')}"
    return "BACKUP STATUS\nNo successful backup recorded yet."


def backup_due() -> bool:
    last = parse_iso(get_meta("last_backup_at", ""))
    last_attempt = parse_iso(get_meta("last_backup_attempt_at", ""))
    now = now_utc()
    if last_attempt and now - last_attempt < dt.timedelta(hours=1):
        return False
    return not last or now - last >= dt.timedelta(hours=BACKUP_INTERVAL_HOURS)


def create_and_send_backup(manual: bool = False) -> bool:
    set_meta("last_backup_attempt_at", iso())
    with tempfile.TemporaryDirectory(prefix="44o0_backup_", dir=TEMP_DIR) as tmp:
        root = Path(tmp)
        snapshot = root / "44o0_state.sqlite3"
        source = connect()
        target = sqlite3.connect(snapshot)
        try:
            source.backup(target)
        finally:
            target.close()
            source.close()

        conn = connect()
        try:
            rows = conn.execute("SELECT * FROM reels ORDER BY order_index").fetchall()
            columns = [d[0] for d in conn.execute("SELECT * FROM reels LIMIT 0").description]
        finally:
            conn.close()

        csv_path = root / "reels_inventory.csv"
        with csv_path.open("w", encoding="utf-8", newline="") as f:
            writer = csv.writer(f)
            writer.writerow(columns)
            for row in rows:
                writer.writerow([row[col] for col in columns])

        json_path = root / "reels_inventory.json"
        json_path.write_text(json.dumps([{col: row[col] for col in columns} for row in rows], ensure_ascii=False, indent=2), encoding="utf-8")

        config_path = root / "recovery_info.json"
        config_path.write_text(
            json.dumps(
                {
                    "app": APP_NAME,
                    "version": APP_VERSION,
                    "created_at": iso(),
                    "instagram_username": "44.o0",
                    "instagram_user_id": INSTAGRAM_USER_ID,
                    "drive_folder_id": DRIVE_FOLDER_ID,
                    "post_times": POST_TIMES,
                    "timezone": TIMEZONE_NAME,
                    "max_attempts": MAX_ATTEMPTS,
                    "analytics_delay_hours": ANALYTICS_DELAY_HOURS,
                    "backup_interval_hours": BACKUP_INTERVAL_HOURS,
                    "note": "Secrets are intentionally excluded. Re-add Instagram and Telegram tokens as Railway environment variables during recovery.",
                },
                indent=2,
            ),
            encoding="utf-8",
        )

        stamp = now_local().strftime("%Y-%m-%d_%H%M")
        zip_path = root / f"44o0_backup_{stamp}.zip"
        with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as zf:
            zf.write(snapshot, snapshot.name)
            zf.write(csv_path, csv_path.name)
            zf.write(json_path, json_path.name)
            zf.write(config_path, config_path.name)

        ok = send_document(zip_path, f"@44.o0 recovery backup — {now_local().strftime('%d %b %Y, %I:%M %p IST')}")
        if ok:
            set_meta("last_backup_at", iso())
            log_event("backup", "SENT", detail=f"manual={manual}; bytes={zip_path.stat().st_size}")
            return True
        log_event("backup", "FAILED", detail="Telegram sendDocument failed")
        return False


def backup_worker(manual: bool = False) -> None:
    try:
        ok = create_and_send_backup(manual=manual)
        if manual:
            send_message("BACKUP COMPLETE" if ok else "BACKUP FAILED — check Railway logs.")
    except Exception as exc:
        log_event("backup", "ERROR", detail=traceback.format_exc())
        if manual:
            send_message("BACKUP ERROR\n" + short_error(exc))


# ----------------------------- Telegram command handling -----------------------------
def run_rescan_async() -> None:
    try:
        send_message("Drive rescan started. Existing posting history will not be changed.")
        seen, added = rescan_inventory()
        send_message(f"DRIVE RESCAN COMPLETE\nFiles seen: {seen}\nNew Reels added: {added}\nExisting states preserved.")
    except Exception as exc:
        log_event("inventory", "ERROR", detail=traceback.format_exc())
        send_message("DRIVE RESCAN FAILED\n" + short_error(exc))


def handle_command(text: str) -> None:
    parts = text.strip().split()
    command = parts[0].split("@", 1)[0].lower() if parts else ""
    arg = parts[1] if len(parts) > 1 else ""

    if command in {"/start", "/panel"}:
        send_message("@44.o0 AUTOMATION CONTROL", root_menu())
    elif command == "/status":
        send_message(status_text())
    elif command == "/next":
        send_message(next_text())
    elif command == "/stats":
        send_message(stats_text())
    elif command == "/queue":
        send_message(queue_text())
    elif command == "/history":
        send_message(history_text())
    elif command == "/failed":
        send_message(list_status_text("FAILED"))
    elif command == "/skipped":
        send_message(list_status_text("SKIPPED"))
    elif command == "/uncertain":
        send_message(list_status_text("UNCERTAIN"))
    elif command == "/top":
        send_message(top_text())
    elif command == "/config":
        send_message(config_text())
    elif command == "/health":
        send_message(health_text())
    elif command == "/logs":
        mode = arg.lower() if arg.lower() in {"today", "posted", "failed", "uncertain", "errors"} else "all"
        send_message(logs_text(mode))
    elif command == "/pause":
        set_meta("paused", "1")
        log_event("control", "PAUSED", detail="Telegram")
        send_message("Automation PAUSED. Manual /postnow remains available.")
    elif command == "/resume":
        set_meta("paused", "0")
        log_event("control", "RESUMED", detail="Telegram")
        send_message("Automation RESUMED.\n" + status_text())
    elif command == "/postnow":
        if start_post_job("telegram_postnow"):
            send_message("Manual post started. Normal 1:00 PM / 8:30 PM schedule is unchanged.")
        else:
            send_message("Posting already in progress, or posting is blocked. No second job was queued.")
    elif command == "/skip":
        try:
            rid = int(arg) if arg else None
            send_message(skip_reel(rid))
        except ValueError:
            send_message("Usage: /skip or /skip REEL_ID")
    elif command == "/unskip":
        try:
            send_message(unskip_reel(int(arg)))
        except ValueError:
            send_message("Usage: /unskip REEL_ID")
    elif command == "/retry":
        try:
            send_message(retry_failed(int(arg)))
        except ValueError:
            send_message("Usage: /retry REEL_ID")
    elif command == "/rescan":
        threading.Thread(target=run_rescan_async, name="rescan", daemon=True).start()
    elif command == "/backup":
        threading.Thread(target=backup_worker, kwargs={"manual": True}, name="backup", daemon=True).start()
    elif command == "/help":
        send_message(
            "COMMANDS\n"
            "/panel /status /next /stats /queue /history\n"
            "/failed /skipped /uncertain /top /config /health\n"
            "/logs [today|posted|failed|uncertain|errors]\n"
            "/pause /resume /postnow\n"
            "/skip [ID] /unskip ID /retry ID\n"
            "/rescan /backup"
        )
    else:
        send_message("Unknown command. Use /panel or /help.")


def answer_callback(callback_id: str) -> None:
    tg_api("answerCallbackQuery", data={"callback_query_id": callback_id})


def handle_callback(data: str, callback_id: str) -> None:
    answer_callback(callback_id)
    if data == "menu:root":
        send_message("@44.o0 AUTOMATION CONTROL", root_menu())
    elif data == "menu:posting":
        send_message("POSTING", posting_menu())
    elif data == "menu:queue":
        send_message("QUEUE", queue_menu())
    elif data == "menu:analytics":
        send_message("ANALYTICS", analytics_menu())
    elif data == "menu:system":
        send_message("SYSTEM", system_menu())
    elif data == "menu:backup":
        send_message("BACKUP", backup_menu())
    elif data.startswith("confirm:"):
        action = data.split(":", 1)[1]
        labels = {"postnow": "Post the next Reel now?", "skipnext": "Skip the next Reel?", "rescan": "Scan Drive now and append only new files?", "backup": "Create and send a recovery backup now?"}
        send_message(labels.get(action, "Confirm action?"), confirm_menu(action))
    elif data == "do:postnow":
        if start_post_job("telegram_button"):
            send_message("Manual post started. Scheduled times are unchanged.")
        else:
            send_message("Posting already in progress, or posting is blocked.")
    elif data == "do:skipnext":
        send_message(skip_reel())
    elif data == "do:rescan":
        threading.Thread(target=run_rescan_async, name="rescan", daemon=True).start()
    elif data == "do:backup":
        threading.Thread(target=backup_worker, kwargs={"manual": True}, name="backup", daemon=True).start()
    elif data == "act:pause":
        set_meta("paused", "1")
        send_message("Automation PAUSED.", posting_menu())
    elif data == "act:resume":
        set_meta("paused", "0")
        send_message("Automation RESUMED.", posting_menu())
