    if size > VIDEO_MAX_BYTES:
        path.unlink(missing_ok=True)
        raise RuntimeError(f"Downloaded Reel is {size} bytes, above Instagram's 1 GB limit")
    return path


def cleanup_temp_files() -> int:
    TEMP_DIR.mkdir(parents=True, exist_ok=True)
    removed = 0
    for path in TEMP_DIR.iterdir():
        if path.is_file():
            with contextlib.suppress(Exception):
                path.unlink()
                removed += 1
        elif path.is_dir():
            with contextlib.suppress(Exception):
                shutil.rmtree(path)
                removed += 1
    return removed


# ----------------------------- Public media server -----------------------------
def register_public_file(path: Path) -> tuple[str, str]:
    token = hashlib.sha256(os.urandom(48)).hexdigest()
    with PUBLIC_FILES_LOCK:
        PUBLIC_FILES[token] = path
    return token, f"{PUBLIC_BASE_URL}/media/{token}"


def unregister_public_file(token: str) -> None:
    with PUBLIC_FILES_LOCK:
        PUBLIC_FILES.pop(token, None)


class Handler(BaseHTTPRequestHandler):
    server_version = "44o0/1.0"

    def log_message(self, fmt: str, *args: Any) -> None:
        LOG.info("http %s - %s", self.address_string(), fmt % args)

    def _health(self) -> None:
        payload = json.dumps(
            {
                "ok": not bool(SAFE_HALT_REASON),
                "app": APP_NAME,
                "version": APP_VERSION,
                "safe_halt": SAFE_HALT_REASON or None,
            }
        ).encode()
        self.send_response(200 if not SAFE_HALT_REASON else 503)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(payload)

    def _serve_media(self, token: str) -> None:
        with PUBLIC_FILES_LOCK:
            path = PUBLIC_FILES.get(token)
        if path is None or not path.exists():
            self.send_error(404)
            return
        size = path.stat().st_size
        start, end = 0, size - 1
        range_header = self.headers.get("Range", "")
        partial = False
        if range_header.startswith("bytes="):
            match = re.match(r"bytes=(\d*)-(\d*)", range_header)
            if match:
                if match.group(1):
                    start = int(match.group(1))
                if match.group(2):
                    end = int(match.group(2))
                end = min(end, size - 1)
                if start <= end:
                    partial = True
        length = end - start + 1
        self.send_response(206 if partial else 200)
        self.send_header("Content-Type", mimetypes.guess_type(path.name)[0] or "video/mp4")
        self.send_header("Accept-Ranges", "bytes")
        self.send_header("Content-Length", str(length))
        if partial:
            self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
        self.end_headers()
        if self.command == "HEAD":
            return
        with path.open("rb") as f:
            f.seek(start)
            remaining = length
            while remaining > 0:
                chunk = f.read(min(1024 * 1024, remaining))
                if not chunk:
                    break
                self.wfile.write(chunk)
                remaining -= len(chunk)

    def do_HEAD(self) -> None:
        self.do_GET()

    def do_GET(self) -> None:
        parsed = urllib.parse.urlsplit(self.path)
        if parsed.path in {"/", "/health", "/healthz"}:
            self._health()
            return
        if parsed.path.startswith("/media/"):
            token = parsed.path.split("/", 2)[2]
            self._serve_media(token)
            return
        self.send_error(404)


def start_http_server() -> ThreadingHTTPServer:
    server = ThreadingHTTPServer(("0.0.0.0", PORT), Handler)
    thread = threading.Thread(target=server.serve_forever, name="http", daemon=True)
    thread.start()
    return server


# ----------------------------- Instagram API -----------------------------
class InstagramError(RuntimeError):
    def __init__(self, message: str, status: int = 0, payload: Any = None):
        super().__init__(message)
        self.status = status
        self.payload = payload


class AmbiguousPublishError(RuntimeError):
    pass


def graph_request(method: str, path: str, data: Optional[dict[str, Any]] = None, timeout: int = 60) -> dict[str, Any]:
    url = f"{GRAPH_BASE}/{path.lstrip('/')}"
    headers = {"Authorization": f"Bearer {INSTAGRAM_ACCESS_TOKEN}", "Accept": "application/json"}
    try:
        if method.upper() == "GET":
            response = HTTP.get(url, params=data or {}, headers=headers, timeout=timeout)
        else:
            response = HTTP.post(url, data=data or {}, headers=headers, timeout=timeout)
    except requests.RequestException as exc:
        raise InstagramError("Instagram network error: " + short_error(exc)) from exc
    try:
        payload = response.json() if response.content else {}
    except ValueError:
        payload = {"raw": response.text[:1000]}
    if not response.ok:
        error = payload.get("error", {}) if isinstance(payload, dict) else {}
        message = error.get("message") if isinstance(error, dict) else None
        detail = message or response.text or response.reason
        raise InstagramError(f"Instagram HTTP {response.status_code}: {short_error(detail)}", response.status_code, payload)
    if not isinstance(payload, dict):
        raise InstagramError("Instagram returned a non-object JSON response")
    return payload


def verify_instagram() -> tuple[str, str]:
    me = graph_request("GET", "me", {"fields": "id,username"})
    actual_id = str(me.get("id") or "")
    username = str(me.get("username") or "")
    if actual_id != INSTAGRAM_USER_ID:
        raise RuntimeError(f"Token belongs to Instagram ID {actual_id or '<missing>'}, expected {INSTAGRAM_USER_ID}")
    return actual_id, username


def create_container(video_url: str, caption: str) -> str:
    payload = graph_request(
        "POST",
        f"{INSTAGRAM_USER_ID}/media",
        {
            "media_type": "REELS",
            "video_url": video_url,
            "caption": caption,
            "share_to_feed": "true" if SHARE_TO_FEED else "false",
        },
        timeout=90,
    )
    container_id = str(payload.get("id") or "").strip()
    if not container_id:
        raise InstagramError("Create-container response did not contain an id")
    return container_id


def poll_container(container_id: str, timeout_seconds: int = 300) -> None:
    deadline = time.monotonic() + timeout_seconds
    last: dict[str, Any] = {}
    while time.monotonic() < deadline:
        last = graph_request("GET", container_id, {"fields": "id,status_code,status"}, timeout=45)
        status = str(last.get("status_code") or "").upper()
        if status == "FINISHED":
            return
        if status in {"ERROR", "EXPIRED"}:
            raise InstagramError(f"Container ended as {status}: {short_error(last.get('status') or last)}")
        time.sleep(5)
    raise InstagramError(f"Container did not reach FINISHED within {timeout_seconds}s; last={short_error(last)}")


def publish_container(container_id: str) -> str:
    url = f"{GRAPH_BASE}/{INSTAGRAM_USER_ID}/media_publish"
    headers = {"Authorization": f"Bearer {INSTAGRAM_ACCESS_TOKEN}", "Accept": "application/json"}
    try:
        response = HTTP.post(url, data={"creation_id": container_id}, headers=headers, timeout=60)
    except requests.RequestException as exc:
        raise AmbiguousPublishError("media_publish response was lost: " + short_error(exc)) from exc
    try:
        payload = response.json() if response.content else {}
    except ValueError:
        payload = {"raw": response.text[:1000]}
    if response.status_code >= 500:
        raise AmbiguousPublishError(f"Instagram returned HTTP {response.status_code} during media_publish")
    if not response.ok:
        error = payload.get("error", {}) if isinstance(payload, dict) else {}
        message = error.get("message") if isinstance(error, dict) else response.text
        raise InstagramError(f"Instagram HTTP {response.status_code}: {short_error(message)}", response.status_code, payload)
    media_id = str(payload.get("id") or "").strip() if isinstance(payload, dict) else ""
    if not media_id:
        raise AmbiguousPublishError("media_publish returned success without a media id")
    return media_id


def get_permalink(media_id: str) -> str:
    try:
        payload = graph_request("GET", media_id, {"fields": "permalink"})
        return str(payload.get("permalink") or "")
    except Exception:
        return ""


# ----------------------------- Queue / posting -----------------------------
def get_next_reel() -> Optional[sqlite3.Row]:
    conn = connect()
    try:
        return conn.execute(
            """
            SELECT * FROM reels
            WHERE status='PENDING' AND attempts < ?
            ORDER BY order_index ASC LIMIT 1
            """,
            (MAX_ATTEMPTS,),
        ).fetchone()
    finally:
        conn.close()


def get_reel(reel_id: int) -> Optional[sqlite3.Row]:
    conn = connect()
    try:
        return conn.execute("SELECT * FROM reels WHERE id=?", (reel_id,)).fetchone()
    finally:
        conn.close()

