# ----------------------------- General helpers -----------------------------

def now_utc() -> dt.datetime:
    return dt.datetime.now(dt.timezone.utc)


def now_local() -> dt.datetime:
    return now_utc().astimezone(TZ)


def iso(value: Optional[dt.datetime] = None) -> str:
    return (value or now_utc()).astimezone(dt.timezone.utc).isoformat(timespec="seconds")


def parse_iso(value: Optional[str]) -> Optional[dt.datetime]:
    if not value:
        return None
    try:
        out = dt.datetime.fromisoformat(value)
        if out.tzinfo is None:
            out = out.replace(tzinfo=dt.timezone.utc)
        return out.astimezone(dt.timezone.utc)
    except ValueError:
        return None


def short_error(exc: BaseException | str, limit: int = 900) -> str:
    text = str(exc)
    if INSTAGRAM_ACCESS_TOKEN:
        text = text.replace(INSTAGRAM_ACCESS_TOKEN, "<redacted>")
    if TELEGRAM_BOT_TOKEN:
        text = text.replace(TELEGRAM_BOT_TOKEN, "<redacted>")
    text = re.sub(r"(?i)(access_token=)[^&\s]+", r"\1<redacted>", text)
    return text[:limit]


def natural_parts(value: str) -> tuple[Any, ...]:
    parts: list[Any] = []
    for token in re.split(r"(\d+)", value.casefold()):
        if token.isdigit():
            parts.append((0, int(token)))
        else:
            parts.append((1, token))
    return tuple(parts)


def validate_times() -> None:
    if len(POST_TIMES) != 2:
        raise RuntimeError("REEL_POST_TIMES must contain exactly two HH:MM values for this automation")
    for value in POST_TIMES:
        dt.datetime.strptime(value, "%H:%M")


def required_config_missing() -> list[str]:
    values = {
        "DRIVE_FOLDER_ID": DRIVE_FOLDER_ID,
        "INSTAGRAM_USER_ID": INSTAGRAM_USER_ID,
        "INSTAGRAM_ACCESS_TOKEN": INSTAGRAM_ACCESS_TOKEN,
        "TELEGRAM_BOT_TOKEN": TELEGRAM_BOT_TOKEN,
        "TELEGRAM_OWNER_ID": TELEGRAM_OWNER_ID,
        "PUBLIC_BASE_URL": PUBLIC_BASE_URL,
    }
    return [key for key, value in values.items() if not value]


# ----------------------------- SQLite -----------------------------

def connect() -> sqlite3.Connection:
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(DB_PATH, timeout=30)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("PRAGMA synchronous=FULL")
    conn.execute("PRAGMA foreign_keys=ON")
    return conn


def init_db() -> None:
    existed = DB_PATH.exists()
    conn = connect()
    try:
        conn.executescript(
            """
            CREATE TABLE IF NOT EXISTS meta (
                key TEXT PRIMARY KEY,
                value TEXT NOT NULL,
                updated_at TEXT NOT NULL
            );

            CREATE TABLE IF NOT EXISTS reels (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                file_id TEXT NOT NULL UNIQUE,
                folder_path TEXT NOT NULL,
                filename TEXT NOT NULL,
                drive_url TEXT NOT NULL,
                order_index INTEGER NOT NULL UNIQUE,
                status TEXT NOT NULL DEFAULT 'PENDING',
                attempts INTEGER NOT NULL DEFAULT 0,
                caption TEXT,
                caption_strategy TEXT,
                caption_key TEXT,
                hashtag_pack TEXT,
                container_id TEXT,
                media_id TEXT,
                permalink TEXT,
                last_error TEXT,
                discovered_at TEXT NOT NULL,
                last_attempt_at TEXT,
                posted_at TEXT,
                analytics_due_at TEXT,
                analytics_collected_at TEXT,
                analytics_attempts INTEGER NOT NULL DEFAULT 0,
                analytics_next_retry_at TEXT,
                analytics_error TEXT,
                views INTEGER,
                reach INTEGER,
                likes INTEGER,
                comments INTEGER,
                shares INTEGER,
                saved INTEGER,
                follows INTEGER,
                avg_watch_time REAL,
                total_watch_time REAL,
                updated_at TEXT NOT NULL
            );
            CREATE INDEX IF NOT EXISTS idx_reels_status_order ON reels(status, order_index);
            CREATE INDEX IF NOT EXISTS idx_reels_analytics_due ON reels(analytics_due_at, analytics_collected_at);

            CREATE TABLE IF NOT EXISTS events (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                event_type TEXT NOT NULL,
                status TEXT NOT NULL,
                reel_id INTEGER,
                detail TEXT,
                created_at TEXT NOT NULL
            );
            CREATE INDEX IF NOT EXISTS idx_events_created ON events(created_at);

            CREATE TABLE IF NOT EXISTS schedule_slots (
                slot_key TEXT PRIMARY KEY,
                claimed_at TEXT NOT NULL
            );
            """
        )
        check = conn.execute("PRAGMA integrity_check").fetchone()[0]
        if str(check).lower() != "ok":
            raise RuntimeError(f"SQLite integrity check failed: {check}")
        conn.commit()
        if not existed:
            set_meta_conn(conn, "database_created_at", iso())
    finally:
        conn.close()


def set_meta_conn(conn: sqlite3.Connection, key: str, value: str) -> None:
    conn.execute(
        """
        INSERT INTO meta(key,value,updated_at) VALUES(?,?,?)
        ON CONFLICT(key) DO UPDATE SET value=excluded.value, updated_at=excluded.updated_at
        """,
        (key, value, iso()),
    )
    conn.commit()

